<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/rounded_bottom_teal_bg"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/btnKembaliContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnKembali"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Kembali"
                android:scaleType="centerInside"
                android:layout_gravity="center"
                android:background="@drawable/ic_circle_back"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaksi Pembayaran"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <RelativeLayout
        android:id="@+id/searchLayout"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp">
        <EditText
            android:id="@+id/etNosam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:importantForAutofill="no"
            android:autofillHints="username"
            android:hint="Cari Nosam"
            android:background="@drawable/input_background"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="106dp"
            android:paddingBottom="16dp"
            android:textColorHint="#858484"
            android:singleLine="true"
            android:ellipsize="end"
            android:scrollHorizontally="true"
            android:imeOptions="actionSearch"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp">
            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clear"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"
                app:tint="@color/silver"
                android:layout_centerVertical="true"
                android:layout_marginTop="9.6dp"/>
            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#808080"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"/>
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageButton
                    android:id="@+id/btnCari"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_search"
                    android:scaleType="centerInside"
                    android:layout_gravity="center"
                    app:tint="@color/white"
                    android:padding="8dp"
                    android:background="@drawable/ic_circle_search_button"/>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <HorizontalScrollView
        android:id="@+id/filterScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchLayout"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnHariIni"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:textSize="9dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/rounded_button_basic_selector"
                android:paddingHorizontal="13dp"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                android:text="Transaksi Hari Ini" />

            <Button
                android:id="@+id/btnSemua"
                android:layout_width="125dp"
                android:layout_height="30dp"
                android:textSize="9dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/rounded_button_basic_selector"
                android:paddingHorizontal="13dp"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                android:text="Semua Transaksi" />

            <Button
                android:id="@+id/btnExportExcel"
                android:layout_width="77dp"
                android:layout_height="30dp"
                android:textSize="10dp"
                android:layout_marginEnd="4dp"
                android:text="CSV"
                android:background="@drawable/rounded_button_white_selector"
                android:textColor="@color/basic" />

            <Button
                android:id="@+id/btnExportPdf"
                android:layout_width="77dp"
                android:layout_height="30dp"
                android:textSize="10dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/rounded_button_white_selector"
                android:text="PDF"
                android:textColor="@color/basic" />

        </LinearLayout>

    </HorizontalScrollView>
    <LinearLayout
        android:id="@+id/layoutPeriode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/filterScrollView"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:id="@+id/startDateLayout"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai: "
                    android:textSize="10dp"
                    android:textColor="@color/black"/>
                <TextView
                    android:id="@+id/tvStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YYYY-MM-DD"
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:layout_marginStart="4dp"/>
                <ImageButton
                    android:id="@+id/btnStartDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_calender_start"
                    android:background="@android:color/transparent"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <LinearLayout
                android:id="@+id/endDateLayout"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/input_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akhir: "
                    android:textSize="10dp"
                    android:textColor="@color/black"/>
                <TextView
                    android:id="@+id/tvEndDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YYYY-MM-DD"
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:layout_marginStart="4dp"/>
                <ImageButton
                    android:id="@+id/btnEndDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_calender_end"
                    android:background="@android:color/transparent"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnCariPeriode"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:text="Cari"
                android:background="@drawable/rounded_button_basic_selector"
                android:layout_gravity="center_vertical"
                android:textSize="10dp"
                android:textColor="@color/white"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutPeriode"
        android:gravity="center"
        android:text="Hari ini belum terdapat transaksi pembayaran"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="343dp"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutPeriode"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:padding="0dp" />



</RelativeLayout>