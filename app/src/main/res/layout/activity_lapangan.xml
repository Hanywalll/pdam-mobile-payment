<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_bottom_teal_bg"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/btnKembaliContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btnKembali"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_circle_back"
                    android:contentDescription="Kembali"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_back" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tagihan Pelanggan"
                android:textColor="@android:color/white"
                android:textSize="18dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="10dp">

            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="330dp"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etNomorSambungan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:importantForAutofill="no"
                    android:autofillHints="username"
                    android:hint="Cari Nosam"
                    android:background="@drawable/input_background"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:layout_marginTop="20dp"
                    android:paddingEnd="150dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColorHint="#858484"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:scrollHorizontally="true"
                    android:imeOptions="actionSearch"
                    android:layout_centerVertical="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <ImageButton
                        android:id="@+id/btnClear"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clear"
                        android:background="@android:color/transparent"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="8dp"
                        app:tint="@color/silver"
                        android:layout_marginTop="12dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:background="#808080"
                        android:layout_marginEnd="8dp"
                        android:layout_gravity="center_vertical" />

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp">

                        <ImageButton
                            android:id="@+id/btnCariNomor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_search"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            app:tint="@color/white"
                            android:padding="8dp"
                            android:background="@drawable/ic_circle_search_button" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="4dp">

                        <ImageButton
                            android:id="@+id/btnScanBarcode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_camera"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            app:tint="@color/white"
                            android:background="@drawable/ic_circle_search_button" />
                    </FrameLayout>
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvHasilScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:padding="12dp"
                android:background="@drawable/rounded_top_teal_bg"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone"
                android:maxLines="1"
                android:ellipsize="end" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:padding="8dp"
                        android:layout_marginLeft="3dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_identity" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Identitas Pelanggan"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:paddingStart="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_person" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Nama"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvNama"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:maxLines="5"
                                android:ellipsize="end"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_home" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Alamat"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvAlamat"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:maxLines="5"
                                android:ellipsize="end"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_golongan" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kode Gol"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvKodeGolongan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_status" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Status"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#808080"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:layout_marginStart="-8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_report" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Rekapitulasi Tagihan"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnDetailTransaksi"
                            android:layout_width="125dp"
                            android:layout_height="30dp"
                            android:textSize="9dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/rounded_button_basic_selector"
                            android:paddingHorizontal="13dp"
                            android:text="Detail Transaksi"
                            android:textColor="@color/white"

                            />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:paddingStart="-5dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tunggakan"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvTunggakan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:maxLines="5"
                                android:ellipsize="end"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:paddingStart="-5dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pemakaian Air"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvPemakaianAir"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:paddingStart="-5dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Rekening Air"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvRekeningAir"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:paddingStart="-5dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Maintenance"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvMaintenance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:paddingStart="-5dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Res.Kebersihan"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvResKebersihan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top"
                            android:padding="8dp"
                            android:paddingStart="-5dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Denda"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />

                            <TextView
                                android:id="@+id/tvDenda"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="-"
                                android:textStyle="normal"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:paddingStart="8dp" />
                        </LinearLayout>


                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/rounded_top_teal_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_margin="0dp">

            <!-- Kolom Kiri: Jumlah Tagihan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Jumlah Tagihan"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvJumlahTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="-"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kolom Kanan: Tombol Bayar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnBayar"
                    android:layout_width="115dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/rounded_button_white_selector"
                    android:text="Bayar Tagihan"
                    android:textColor="#0465D5"
                    android:textSize="9dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:indeterminate="true"
        style="?android:attr/progressBarStyleLarge"
        android:indeterminateDrawable="@drawable/custom_progress_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</FrameLayout>