<network-security-config>
    <!-- Base configuration with certificate pinning removed -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain configuration -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tagihanairpdamtidha.my.id</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>